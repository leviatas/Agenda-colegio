generator client {
  provider      = "prisma-client-js"
  // "native" cubre el dev local (Windows/macOS/Debian); el target musl es
  // obligatorio para la imagen node:20-alpine del Dockerfile.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Una sola organización (un colegio), así que no hay Company/Membership: el
// único rol es isAdmin, que sale de ADMIN_EMAILS en cada login. Cualquier
// cuenta de Google que entra puede cargar sus eventos personales de una, sin
// esperar aprobación de nadie; lo único reservado al admin es editar el
// calendario oficial.
model User {
  id        Int     @id @default(autoincrement())
  googleId  String  @unique
  email     String  @unique
  name      String
  avatarUrl String?
  isAdmin   Boolean @default(false)

  // Los filtros del picker ("Sala Celeste", "3° grado"…) como JSON: un array
  // de ids del catálogo del cliente (client/src/lib/agenda.js). Va acá y no en
  // una tabla aparte porque siempre se lee y se escribe entero, y porque el
  // catálogo es del cliente — la base no tiene por qué conocer los ids.
  picks String @default("[]")

  // El código para "compartir todos mis eventos" (ver EventSubscription). Nulo
  // mientras nadie lo generó o después de apagarlo; no se reutiliza el mismo
  // valor entre cuentas por el @unique. Apagarlo (ponerlo null) sólo cierra la
  // puerta a canjes NUEVOS: a quien ya canjeó no se le toca su fila de
  // EventSubscription, eso es un acto aparte (sacarlo de la lista de
  // suscriptores).
  shareCode String? @unique

  createdAt DateTime @default(now())

  events            PersonalEvent[]
  suscriptoresDe    EventSubscription[] @relation("Owner")
  suscripciones     EventSubscription[] @relation("Subscriber")
  accesos           Visita[]
  suscripcionesPush PushSubscription[]
  novedadesCerradas NovedadCierre[]
}

// Calendario oficial del colegio. Lo edita SOLO un admin (routes/oficial.js);
// se lee sin login.
model Event {
  id      Int     @id @default(autoincrement())
  // Fechas como String 'YYYY-MM-DD', NO DateTime: son fechas de calendario sin
  // hora. Un DateTime en SQLite se guarda en UTC, así que un 2026-09-01 local
  // vuelve como 2026-08-31T21:00Z y el evento se corre un día según el huso de
  // quien lo lea. Con String la fecha es la que se cargó, siempre.
  date    String
  endDate String? // tramos de varios días: último día, inclusive

  // 'ini' | 'pri' | 'sec' | 'ins' | 'fer'. SQLite no tiene enums: se valida en
  // la capa de aplicación (LEVELS en routes/oficial.js). 'per' NO es válido
  // acá: los personales viven en PersonalEvent.
  level String

  // Hora en el formato que muestra la agenda ('8.15', '13.30', '8 a 15'), como
  // texto libre: hay eventos con rango y otros sin hora.
  time    String?
  // Hora de fin, opcional e independiente de endDate: un acto puede ser "de
  // 8.15 a 12.30" el mismo día. Sólo tiene sentido con `time` cargada; se
  // valida en la aplicación (parseEvento). Nula en todo lo que ya estaba.
  endTime String?
  title   String

  // A qué salas / grados / años aplica, como JSON de tags del catálogo
  // (['g2'], ['s3'], ['celeste'], ['maternal']). Vacío = a todo el nivel.
  groups String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Los "eventos extras" de cada familia. Son privados: nadie más los ve, ni
// siquiera el admin. Se muestran con el nivel 'per' del cliente.
model PersonalEvent {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  date    String
  endDate String?
  time    String?
  endTime String?
  title   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Suscripción en vivo a TODOS los eventos personales de otra cuenta: mientras
// exista esta fila, `subscriberId` ve los de `ownerId` mezclados en su
// calendario (de sólo lectura, nunca al revés). Se crea al canjear el
// `shareCode` del dueño; se borra al desuscribirse una punta o al ser
// removido por la otra (routes/eventos.js, prefijo /compartir). Es
// intencional que sea de una sola dirección: compartir tus eventos no hace
// que veas los de quien canjeó tu código.
model EventSubscription {
  id           Int  @id @default(autoincrement())
  ownerId      Int
  owner        User @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  subscriberId Int
  subscriber   User @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ownerId, subscriberId])
  @@index([subscriberId])
}

// Accesos por IP, para /metricas (sólo admin, ver routes/metricas.js).
// Aparte de lib/telemetria.js a propósito: ese archivo es el conteo anónimo
// que sale por stdout y nunca guarda IP ni mail (ver el comentario de ahí).
// Esta tabla sí persiste la IP, así que vive detrás de requireAdmin en todo
// momento y sólo cuenta accesos — nunca contenido de nadie. `userId` es nulo
// en una visita sin sesión; si más tarde esa cuenta se borra, la fila de
// acceso queda igual (`SetNull`), no desaparece con ella.
model Visita {
  id     Int   @id @default(autoincrement())
  ip     String
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  creadoEn DateTime @default(now())

  @@index([ip])
  @@index([creadoEn])
}

// Un dispositivo suscripto a las notificaciones push de "hoy tenés eventos"
// (ver server/src/lib/push.js). `endpoint` identifica el navegador/dispositivo
// ante el servicio de push de Google/Apple/Mozilla, así que es la clave real
// — no hay dos filas para el mismo endpoint (volver a suscribirse actualiza
// la fila existente en vez de duplicarla).
//
// `userId` es nulo sin cuenta: cargar eventos propios no pide login (ver
// CLAUDE.md), así que las notificaciones tampoco. Pero sin cuenta el server
// no tiene forma de saber los eventos personales de ese navegador —viven
// sólo en su localStorage—, así que a un anónimo sólo se le avisa por los
// oficiales que le tocan según `picks`. Con cuenta se usa siempre
// `User.picks` (la fuente de verdad), no esta columna: `picks` acá es sólo
// el snapshot con el que se suscribió alguien sin cuenta, porque no hay
// otro lugar donde guardárselo.
model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique
  p256dh   String
  auth     String

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  picks  String @default("[]")

  createdAt DateTime @default(now())
}

// Los avisos que aparecen arriba del calendario ("Novedad: ahora podés…"). Los
// escribe SOLO un admin (routes/novedadesAdmin.js) y se leen sin cuenta, igual
// que el calendario oficial: son para todo el mundo, no para una sala ni un
// grado — por eso no tienen `level` ni `groups`.
//
// `desde` y `hasta` son la ventana en la que la novedad se muestra, y son
// String 'YYYY-MM-DD' por la misma razón que Event.date: son fechas de
// calendario sin hora, y un DateTime en SQLite se guarda en UTC y corre el día
// según el huso de quien lo lea. Fuera de esa ventana la novedad no aparece
// para nadie, la haya cerrado o no — es el corte que no depende del usuario.
model Novedad {
  id     Int    @id @default(autoincrement())
  titulo String
  texto  String
  desde  String
  hasta  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cierres NovedadCierre[]

  // La consulta de siempre es "las vigentes de hoy": desde <= hoy <= hasta.
  @@index([desde, hasta])
}

// Quién cerró qué novedad, para no volver a mostrársela nunca más. Existe sólo
// para las cuentas: sin sesión la marca vive en el localStorage de ese
// navegador (client/src/lib/novedades.js), que es el mismo criterio que los
// eventos personales — sin cuenta no hay dónde guardar nada del lado del
// server.
//
// Es una tabla de marcas, no de contenido: el admin no ve quién cerró qué (no
// hay ninguna pantalla que lo lea), sólo sirve para decidir qué mostrarle a
// cada quien.
model NovedadCierre {
  id        Int     @id @default(autoincrement())
  novedadId Int
  novedad   Novedad @relation(fields: [novedadId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  creadoEn DateTime @default(now())

  // Cerrar dos veces la misma novedad es la misma marca: el upsert de
  // routes/novedades.js se apoya en este unique.
  @@unique([novedadId, userId])
  @@index([userId])
}
