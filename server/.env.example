DATABASE_URL="file:./dev.db"

# OAuth client ID de Google Cloud Console (Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# String largo al azar para firmar los JWT. Generalo con: openssl rand -hex 32
JWT_SECRET="change-me"

# Emails separados por coma que pueden editar el calendario oficial. Se relee en cada login..
ADMIN_EMAILS="leviatas@gmail.com"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Notificaciones push de "hoy tenés eventos" (ver CLAUDE.md, "Notificaciones
# push"). Generalas UNA vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# y no las cambies después: cambiar la clave pública invalida TODAS las
# suscripciones existentes (cada navegador tendría que volver a activarlas).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: o https:// de contacto, va en el header de las requests al
# servicio de push (lo pide el estándar, para que puedan avisarte si tu
# servidor está mandando espam).
VAPID_SUBJECT="mailto:vos@tudominio.com"
